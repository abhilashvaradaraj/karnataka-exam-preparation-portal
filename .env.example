# Copy to .env and edit. Never commit .env.
SECRET_KEY=change-this-to-a-long-random-string
# MySQL (create the database first - see README)
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/karnataka_exam?charset=utf8mb4
# First admin account created by init_db.py
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe#2026
# Scheduler (IST). Set ENABLE_SCHEDULER=0 to disable.
ENABLE_SCHEDULER=1
FETCH_HOUR=6
FETCH_MINUTE=0
FETCH_WINDOW_HOURS=24
# Optional AI (leave blank to run without any paid API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_MAX_PER_RUN=25
